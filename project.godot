; HEAVY BAGGAGE — Godot project configuration
; Engine: Godot 4.4.x (see docs/IMPLEMENTATION_PROGRESS.md for version rationale)

config_version=5

[application]

config/name="HEAVY BAGGAGE"
config/description="Solo & co-op physics horror-comedy about moving sentient furniture."
config/version="0.1.0-vertical-slice"
run/main_scene="res://game/ui/screens/boot.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icons/icon.svg"
boot_splash/show_image=false

[autoload]

Log="*res://game/autoload/log.gd"
EventBus="*res://game/autoload/event_bus.gd"
Services="*res://game/autoload/services.gd"
Platform="*res://game/autoload/platform.gd"
Settings="*res://game/autoload/settings_manager.gd"
InputRebinder="*res://game/autoload/input_rebinder.gd"
ContentDB="*res://game/autoload/content_db.gd"
SaveManager="*res://game/autoload/save_manager.gd"
Loc="*res://game/autoload/localization.gd"
Audio="*res://game/autoload/audio_director.gd"
Net="*res://game/autoload/net_manager.gd"
App="*res://game/autoload/app.gd"
DevTools="*res://game/autoload/dev_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="HeavyBaggage"

