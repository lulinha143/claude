# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
coverage/
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
.playwright/
.playwright-cli/
visual-artifacts/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Secrets / signing — never commit these
*.pem
*.p12
*.pfx
*.keystore
.env
.env.*
!.env.example
build/entitlements.mac.plist.local


# Steam — never commit real build/credential files (only *.example.vdf)
steam/app_build.vdf
steam/depot_windows.vdf
steam/*.vdf
!steam/*.example.vdf
steamcmd/

# local code-review + visual artifacts (never committed)
semantic-review/

# Character master artwork (see assets/sources/characters/manifest.json)
assets/sources/characters/*.png
